{
  "name": "@sakutakajp/hakoniwa",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test:indexing": "node --import tsx --test tests/indexing/*.test.ts",
    "build:exhibits": "vite build --config exhibits/vite.config.ts",
    "typecheck:exhibits": "tsc --project exhibits/tsconfig.json",
    "test:exhibits": "playwright test --config playwright.exhibits.config.ts",
    "build:consumer": "node tests/fixtures/build-consumer.mjs",
    "test:layer": "playwright test --config playwright.layer.config.ts",
    "dev:prepare": "nuxt prepare",
    "test:layer:http": "playwright test --config playwright.layer.config.ts http.spec.ts"
  },
  "dependencies": {
    "@nuxt/kit": "3.14.1592",
    "three": "0.186.1",
    "vite": "5.4.14",
    "@types/three": "0.186.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.6",
    "@playwright/test": "1.58.2",
    "nuxt": "3.14.1592",
    "vue": "3.5.13",
    "vue-router": "4.4.5",
    "tsx": "4.20.5",
    "nuxi": "3.22.3"
  },
  "version": "0.1.0",
  "description": "Reusable Nuxt layer for the Hakoniwa collection at /ja/hakoniwa/",
  "exports": {
    ".": "./nuxt.config.ts"
  },
  "files": [
    "nuxt.config.ts",
    "exhibits",
    "modules",
    "scripts/noindex-static.ts",
    "server",
    "shared",
    "README.md",
    "docs/nuxt-layer.md",
    "public/ja/hakoniwa/fonts",
    "public/ja/hakoniwa/images",
    "public/ja/hakoniwa/library-comparison.html",
    "public/ja/hakoniwa/ocean-diorama",
    "assets",
    "components",
    "data",
    "lib",
    "pages"
  ],
  "peerDependencies": {
    "nuxt": "^3.14.1592 || ^4.0.0",
    "vue": "^3.5.13"
  },
  "overrides": {
    "nitropack": "2.10.4",
    "@rollup/plugin-replace": "6.0.2",
    "rollup": "4.34.9",
    "unstorage": "1.15.0"
  }
}
